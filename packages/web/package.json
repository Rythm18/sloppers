{
  "name": "@sloppers/web",
  "version": "0.1.0",
  "description": "The sloppers office: a walkable pixel workspace for your team's coding agents",
  "license": "MIT",
  "private": true,
  "type": "module",
  "scripts": {
    "gen": "node scripts/gen-assets.mjs",
