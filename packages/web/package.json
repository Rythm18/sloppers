    "tailwindcss": "^4.3.3",
    "zustand": "^5.0.9"
  },
  "devDependencies": {
    "@types/react": "^19.2.9",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.4",
    "pngjs": "^7.0.0",
