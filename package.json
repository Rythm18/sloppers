{
  "name": "sloppers-monorepo",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.20.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm --filter @sloppers/protocol build && pnpm -r typecheck",
    "test": "pnpm --filter @sloppers/protocol build && pnpm -r test",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "demo": "pnpm build && node packages/server/dist/main.js --demo"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.13",
    "typescript": "^5.9.3"
  }
}
